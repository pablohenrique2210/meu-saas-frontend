# URL pública do backend NestJS (sem barra no final)
NEXT_PUBLIC_API_URL=https://SEU-BACKEND-PUBLICO.com

# Clerk: use as chaves da instância de produção no deploy final
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Legado: mantenha apenas enquanto alguma rota antiga ainda enviar para Blob.
# Capas e materiais novos usam Bunny Storage e não precisam destas variáveis.
BLOB_STORE_ID=store_...
BLOB_WEBHOOK_PUBLIC_KEY=...

# Bunny Stream: somente servidor. Nunca use NEXT_PUBLIC_ para a API Key.
# Use a API Key da biblioteca Stream, não a chave global da conta Bunny.
BUNNY_LIBRARY_ID=123456
BUNNY_API_KEY=CHAVE_DA_BIBLIOTECA_STREAM
# Origens exatas, sem barra final, separadas por vírgula; não use curingas.
BUNNY_UPLOAD_ALLOWED_ORIGINS=https://SEU-FRONTEND.vercel.app,http://localhost:3000

# NÃO coloque BUNNY_STORAGE_PASSWORD nem credenciais S3 na Vercel.
# A autorização de capas/materiais é gerada exclusivamente pelo Railway.
